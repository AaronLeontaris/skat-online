# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production
CLIENT_ORIGIN=http://localhost:5173

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skat
POSTGRES_USER=skat
POSTGRES_PASSWORD=skat

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Uploads (avatars)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# Seeded test accounts (v1) — comma-separated "email:password:username"
SEED_ACCOUNTS=anna@example.com:anna123:Anna,ben@example.com:ben123:Ben,clara@example.com:clara123:Clara,david@example.com:david123:David
