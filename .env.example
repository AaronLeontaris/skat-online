# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production
CLIENT_ORIGIN=http://localhost:5173

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skat
POSTGRES_USER=skat
