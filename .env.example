# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Uploads (avatars)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# Seeded test accounts (v1) — comma-separated "email:password:username"
SEED_ACCOUNTS=frieda@example.com:frieda123:Frieda,gabriel@example.com:gabriel123:Gabriel,aaron@example.com:aaron123:Aaron,pascal@example.com:pascal123:Pascal
